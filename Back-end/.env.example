# Copy to your private environment; never commit the completed values.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production: DEBUG=False, set a real secret, domain hosts/CORS,
# HTTPS, managed Postgres via DATABASE_URL, and persistent product media.
# Optional: frontend static site's Render deploy hook, for the admin's
# "Publish to website" button.
# FRONTEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
